# Dev: sem build otimizado, com Maven wrapper para hot reload
FROM maven:3.9-eclipse-temurin-17

WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -q

# Código montado via bind mount no compose.dev
# O Maven fica watching por mudanças

EXPOSE 7070

CMD ["mvn", "compile", "exec:java", "-Dexec.mainClass=crt.Main"]
