# Dev: compila e executa via Maven, sem build otimizado
FROM maven:3.9-eclipse-temurin-17

WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -q

# Código montado via bind mount no compose.dev
# Mudanças no Java requerem restart do container

EXPOSE 7070

CMD ["mvn", "compile", "exec:java", "-Dexec.mainClass=crt.Main"]
